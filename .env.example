# ---------------------------------------------------------------------------
# Flamingo Marketplace — frontend environment variables
# Copy this file to `.env.local` and fill in the real values for your setup.
# ---------------------------------------------------------------------------

# Public canonical site URL (no trailing slash). Used for canonical tags,
# Open Graph, the XML sitemap, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://flamingo.com.ng

# Backend API base URL. Used by both client hooks and server-rendered
# marketplace pages / sitemap. Point this at the deployed NestJS API in prod.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Cloudinary (image uploads for listings, bookings, etc.)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dgpcwsj2e
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
